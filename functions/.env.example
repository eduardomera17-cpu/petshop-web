# Variables de entorno de las Cloud Functions.
# Copia este archivo a functions/.env y rellénalo. functions/.env está en .gitignore: no lo subas.
# Firebase CLI lo carga al desplegar y en los emuladores. Para sobreescribir en local usa functions/.env.local.
# (Los nombres con prefijos FIREBASE_, X_GOOGLE_ o EXT_ están reservados por la plataforma.)

# Bucket de Cloud Storage. Si se deja vacío se usa el bucket por defecto del proyecto.
STORAGE_BUCKET=

# Claves de sitio de reCAPTCHA Enterprise (las mismas que usa la app cliente).
RECAPTCHA_SCORE_SITE_KEY=
RECAPTCHA_CHECKBOX_SITE_KEY=

# Correo saliente (SMTP). Solo hace falta si despliegas el despachador de correo.
# La contraseña/clave SMTP NO va aquí: se guarda en Secret Manager con
#   firebase functions:secrets:set BREVO_SMTP_KEY
SMTP_HOST=
SMTP_USER=
MAIL_FROM=
